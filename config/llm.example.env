# Copy to config/llm.env and fill in. config/llm.env is gitignored — never commit it.
#
# The OpenHands SDK uses LiteLLM, so LLM_MODEL follows LiteLLM's "provider/model" naming.
# Examples:
#   LLM_MODEL=anthropic/claude-sonnet-4-5
#   LLM_MODEL=openai/gpt-5
#   LLM_MODEL=gemini/gemini-2.5-pro
# Check the exact current model id for your provider before using.

LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=
